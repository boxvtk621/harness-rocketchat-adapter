{
  "realm": "harness",
  "enabled": true,
  "displayName": "Harness Local",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "harness-web",
      "name": "Harness Web SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:18000/auth/callback"],
      "webOrigins": ["http://localhost:18000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:18000"
      },
      "protocolMappers": [
        {
          "name": "harness-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {"included.client.audience": "harness-web", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${DEV_USER_USERNAME}",
      "enabled": true,
      "email": "operator@localhost",
      "firstName": "Local",
      "lastName": "Operator",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false}]
    }
  ]
}
