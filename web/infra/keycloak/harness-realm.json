{
  "realm": "harness",
  "enabled": true,
  "displayName": "Harness Local",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "roles": { "realm": [{ "name": "connections.manage", "description": "Manage Harness connections and provider authorization" }] },
  "clients": [
    {
      "clientId": "harness-web",
      "name": "Harness Web SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["${WEB_ORIGIN}/auth/callback"],
      "webOrigins": ["${WEB_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN}"
      },
      "protocolMappers": [
        {
          "name": "harness-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": { "claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true" }
        },
        {
          "name": "harness-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {"included.client.audience": "harness-web", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${DEV_USER_USERNAME}",
      "enabled": true,
      "email": "operator@localhost",
      "firstName": "Local",
      "lastName": "Operator",
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": ["connections.manage"],
      "credentials": [{"type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "observer",
      "firstName": "Local",
      "lastName": "Observer",
      "enabled": true,
      "email": "observer@localhost",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "${DEV_VIEWER_PASSWORD}", "temporary": false }]
    }
  ]
}
